{
  "name": "project-evermore",
  "private": true,
  "version": "0.1.0",
  "description": "An endless, personalized 2D romantic adventure.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "author": "vite --mode author --open /author.html",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "art:her": "node tools/process-art.mjs . her",
    "art:him": "node tools/process-art.mjs . him",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@fontsource/caveat": "^5.2.5",
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/fredoka": "^5.2.5",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "playwright-core": "^1.50.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
